# ── LLM ───────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-your-key-here
# Fallback: leave OPENAI_API_KEY blank to use local Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./careerpilot.db

# ── Gmail OAuth ───────────────────────────────────────────────────────────────
# Download credentials.json from Google Cloud Console (Gmail API enabled)
GMAIL_CREDENTIALS_PATH=./credentials.json
GMAIL_TOKEN_PATH=./token.json

# ── LinkedIn (unofficial API) ─────────────────────────────────────────────────
LINKEDIN_EMAIL=your@email.com
LINKEDIN_PASSWORD=your-password

# ── Job Search ────────────────────────────────────────────────────────────────
# Comma-separated job titles to track
TARGET_ROLES=Machine Learning Engineer,AI Engineer,Data Scientist
# Comma-separated locations (or "Remote")
TARGET_LOCATIONS=Remote,Bangalore,Mumbai
# Max applications per day (safety limit)
MAX_DAILY_APPLICATIONS=10

# ── Predictor ─────────────────────────────────────────────────────────────────
# Minimum fit score (0-100) to auto-recommend an application
MIN_FIT_SCORE=65

# ── Agent ─────────────────────────────────────────────────────────────────────
# How often the Tracker polls for new jobs (seconds)
TRACKER_POLL_INTERVAL=3600
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
